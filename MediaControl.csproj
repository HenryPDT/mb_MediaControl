<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build on Windows: install the .NET SDK, then run  dotnet build -c Release
       Only bin\Release\net48\mb_MediaControl.dll needs to be copied to MusicBee\Plugins. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>mb_MediaControl</AssemblyName>
    <RootNamespace>MusicBeePlugin</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinRT metadata (Windows.Media.SystemMediaTransportControls etc.) for .NET Framework -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.2" />
  </ItemGroup>

</Project>
